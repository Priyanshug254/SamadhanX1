# ================================================================
# SamadhanX Backend — Environment Variables Configuration
# ================================================================
# Copy this file to .env and configure the values for your local environment.
# Never commit your .env file to version control.
# ================================================================

# ── Application ──
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ── Database (PostgreSQL) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=samadhanx_db
DB_USERNAME=samadhanx
DB_PASSWORD=samadhanx_secure_local_dev_pass_2026

# ── Security & JWT ──
# Minimum 32 characters (256-bit) secret key for HMAC-SHA256
JWT_SECRET=super_secret_samadhanx_jwt_signing_key_at_least_32_chars_long_2026!
JWT_EXPIRY_MS=86400000
JWT_REFRESH_EXPIRY_MS=604800000
BCRYPT_STRENGTH=12
